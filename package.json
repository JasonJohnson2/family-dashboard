{
  "name": "family-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm build && node scripts/dev.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "wrangler dev --port 4173",
    "preview:worker": "pnpm build && wrangler dev --port 4173",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:types": "wrangler types --env-interface Env --include-runtime false",
    "db:create": "wrangler d1 create family-dashboard",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "tsx scripts/seed.ts --demo",
    "db:seed:starter": "tsx scripts/seed.ts --remote",
    "db:seed:generate": "tsx scripts/seed.ts --generate-only",
    "test:server": "tsx scripts/test-server.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "miniflare": "5.20260918.0-alpha",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  }
}
