{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  // OAuth callbacks contain short-lived authorization codes; disable automatic request logging.
  "observability": { "enabled": false },
  "vars": { "GOOGLE_APP_ORIGIN": "https://family-dashboard.jjayson400.workers.dev" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-dashboard",
      "database_id": "ca649f90-4f6f-477b-bacc-df4fd095c65e",
      "migrations_dir": "migrations",
    },
  ],
}
